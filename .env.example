# Copia a .env.local (local) o configura en Vercel → Settings → Environment Variables. Nunca subas valores reales a git.

# Base de datos Postgres (Neon, o el Postgres propio del VPS). Sin esto el panel no funciona en Vercel.
DATABASE_URL=

# Firma de sesiones (mín. 32 caracteres aleatorios). Generar:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Solo para `npm run seed:prod` (crea habitaciones reales y el primer administrador)
ADMIN_USUARIO=
ADMIN_CLAVE=

# Sitio público
NEXT_PUBLIC_SITE_URL=https://kiimala-web.vercel.app
NEXT_PUBLIC_WHATSAPP=
